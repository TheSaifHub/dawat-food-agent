# Dawat mobile app: public settings only.
# EVERY EXPO_PUBLIC_ value is embedded in the app bundle and readable by anyone who unpacks the app.
# Never put a secret here: no service keys, no LLM keys, no Google client secret, no payment secret.
# Copy to .env (gitignored). Claude never reads or writes the real .env.

# [PUBLIC] Backend address. Over USB with `adb reverse` the phone's localhost is the PC's localhost.
EXPO_PUBLIC_API_URL=http://localhost:8000

# [PUBLIC] Supabase project URL. Needed only after 30 Oct (real sign-in). Leave empty for local mode.
EXPO_PUBLIC_SUPABASE_URL=

# [PUBLIC] Supabase publishable (anon) key from the Supabase dashboard. Leave empty for local mode.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# [PUBLIC] Google OAuth Web client ID (not the secret). Needed only for real Google sign-in, after 30 Oct.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# NOTE: the local dev-login switch is NOT set here. A script sets it for one dev process only (added in M1).
