{
  "cli": {
    "version": ">= 24.9.0",
    "appVersionSource": "local"
  },
  "build": {
    "apk": {
      "distribution": "internal",
      "autoIncrement": "versionCode",
      "android": { "buildType": "apk" },
      "env": {}
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_DAWAT_DEV_LOGIN": "1" }
    }
  }
}
