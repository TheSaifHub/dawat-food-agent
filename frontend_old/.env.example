# ══════════════════════════════════════════════════════════════════════
#  Dawat frontend: environment variables
# ══════════════════════════════════════════════════════════════════════
#
#  HOW TO USE
#    Local:  copy this file to frontend/.env.local and fill in the values.
#            .env.local is gitignored. Never commit it.
#    Vercel: add the same names and values under Project → Settings →
#            Environment Variables, BEFORE deploying. NEXT_PUBLIC_ values are
#            baked in at build time, so changing one needs a redeploy.
#
#  LEGEND
#    [PUBLIC]  Every variable in this file. The NEXT_PUBLIC_ prefix means
#              Next.js copies the value into the JavaScript sent to every
#              visitor. Anyone can read it in their browser's dev tools.
#
#  ⚠  NEVER PUT A SECRET IN A NEXT_PUBLIC_ VARIABLE.
#     No Supabase secret/service_role key, no database URL, no Gemini/Groq
#     key, no Razorpay key secret. Those belong ONLY in backend/.env.
#     This file has no secret slots, by design. If a feature seems to need a
#     secret in the browser, the logic belongs in the backend instead.
#
#  Leave a line empty (NAME=) until the phase that needs it.
# ══════════════════════════════════════════════════════════════════════


# ─── Backend API ────────────────────────────── needed now (Phase 0) ───

# [PUBLIC] Base URL of the Dawat FastAPI backend (no trailing slash needed).
# Blank → http://localhost:8000
# Vercel example: https://your-backend.onrender.com
NEXT_PUBLIC_API_URL=


# ─── Supabase (auth in the browser) ──────────── needed from Phase 3 ───
# Where: supabase.com → your project → Project Settings → API Keys.

# [PUBLIC] Same value as SUPABASE_URL in backend/.env.
NEXT_PUBLIC_SUPABASE_URL=

# [PUBLIC] The "publishable" key (older dashboards call it the "anon" key).
# Safe in the browser ONLY because Row Level Security limits what it can do.
# NOT the secret / service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# ─── Local dev site (D-059) ──────────────────────── NO slot, by design ───
# NEXT_PUBLIC_DAWAT_DEV_LOGIN is NEVER set here or in Vercel. `npm run dev:local`
# sets it for its own `next dev`; next.config.ts refuses it anywhere else, and
# `npm run build` fails if the dev login ever ends up in a build.

# ─── Razorpay (TEST MODE ONLY) ───────────────── needed from Phase 8 ───

# [PUBLIC] Test key ID (starts with rzp_test_). Same value as RAZORPAY_KEY_ID
# in backend/.env. The key SECRET never goes here.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
