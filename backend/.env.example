# ══════════════════════════════════════════════════════════════════════
#  Dawat backend: environment variables
# ══════════════════════════════════════════════════════════════════════
#
#  HOW TO USE
#    Local:  copy this file to backend/.env and fill in the values.
#            backend/.env is gitignored. Never commit it.
#    Render: paste the same names and values into the service's
#            Environment tab. Don't upload the file.
#
#  LEGEND
#    [SECRET]  Private. Lives ONLY here (backend/.env) and in Render.
#              Never in frontend/, never in code, logs, screenshots,
#              chat messages, agent traces, or a NEXT_PUBLIC_ variable.
#    [CONFIG]  Not sensitive. Safe to show, but still set per environment.
#
#  ⚠  NEVER copy a [SECRET] value into a NEXT_PUBLIC_ variable.
#     Anything named NEXT_PUBLIC_* is baked into the JavaScript that every
#     visitor downloads. A secret there is published to the whole internet.
#
#  Leave a line empty (NAME=) until the phase that needs it. Blank [CONFIG]
#  values fall back to the local default shown in their comment.
# ══════════════════════════════════════════════════════════════════════


# ─── Web / CORS ─────────────────────────────── needed now (Phase 0) ───

# [CONFIG] Comma-separated list of frontend origins allowed to call this API
# from a browser. No "*" (the server refuses to start). No trailing slash needed.
# Blank → http://localhost:3000
# Render example: https://your-app.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=


# ─── Supabase (database + auth) ──────────────── needed from Phase 3 ───
# Where: supabase.com → your project → Project Settings.

# [CONFIG] Project URL, e.g. https://abcdefgh.supabase.co
# Where: Project Settings → API (also shown as "Project URL").
SUPABASE_URL=

# [SECRET] Server-side key. It BYPASSES Row Level Security and can read or
# write every user's data. Backend only, ever.
# Where: Project Settings → API Keys → "secret" key
#        (older dashboards call it the "service_role" key).
SUPABASE_SECRET_KEY=

# [SECRET] Postgres connection string. It contains your database password.
# Used by migrations and the seed script.
# Where: the "Connect" button at the top of the project → connection string
#        (session pooler). Replace [YOUR-PASSWORD] with the DB password.
DATABASE_URL=


# ─── Local test database ─────────────────────── needed from Session 18 ───
# Tests, evals, the rule-breaker and migration rehearsals run ONLY here, never
# on Supabase (D-052). They refuse to start unless the host is this machine.

# [SECRET] The local PostgreSQL 17 you installed (its password is in it).
# Format: postgresql://postgres:<password>@127.0.0.1:5432/dawat_test
# Build/refresh it with: .venv\Scripts\python backend\db\local_setup.py
TEST_DATABASE_URL=


# ─── Local dev site (D-059) ──────────────────────── NO slot, by design ───
# The local dev login's flag, DAWAT_DEV_LOGIN, is NEVER set in this file or in
# Render: only `dev_server.py start` sets it, for its own server process, along
# with the local dev database (dawat_dev, built by
#   .venv\Scripts\python backend\db\local_setup.py --dev). The backend refuses
# to start if the flag is in this file, on Render, or with a remote database.
# `dev_server.py start --supabase` runs on Supabase instead (light checks only).

# ─── LLM providers (Dawat AI) ────────────────── needed from Phase 6 ───
# Free tiers only. LiteLLM reads these exact names automatically.

# [SECRET] Google Gemini, the primary provider.
# Where: aistudio.google.com → Get API key.
GEMINI_API_KEY=

# [SECRET] Groq, the fallback provider.
# Where: console.groq.com → API Keys.
GROQ_API_KEY=

# [CONFIG] Which models to use, tried in order, in LiteLLM "provider/model" format.
# Blank means the defaults (DECISIONS.md D-031, D-036):
#   primary     gemini/gemini-3.5-flash-lite
#   fallback    gemini/gemini-3.8-flash
#   fallback 2  groq/openai/gpt-oss-120b
# Only set these to switch provider or model without a code change.
LLM_PRIMARY_MODEL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_2_MODEL=

# [CONFIG] Chat messages per day (IST) across ALL users: protects the free
# Gemini quota from many demo accounts. Blank → 150. 0 turns chat off.
# Set it to about a third of Gemini's requests/day (DECISIONS.md D-048).
CHAT_DAILY_CAP=


# ─── Payments ───────────────────────────────────────────── Phase 8 ───
# [CONFIG] Which gateway: simulated (default, local, no account or keys needed)
# or razorpay (real test mode, needs the two keys below). DECISIONS.md D-062.
PAYMENT_GATEWAY=

# [SECRET] Optional: signs the simulated gateway's payments. Blank → random
# per server start. Any long random string works. Backend only.
PAYMENT_SIM_SECRET=

# ─── Razorpay (TEST MODE ONLY) ─────────── only if PAYMENT_GATEWAY=razorpay ───
# Where: dashboard.razorpay.com → switch to Test Mode → Account & Settings
#        → API Keys → Generate Test Key. Keys must start with rzp_test_.

# [CONFIG] Test key ID. Public by design: the browser needs it to open checkout.
# The frontend has its own copy (NEXT_PUBLIC_RAZORPAY_KEY_ID), same value.
RAZORPAY_KEY_ID=

# [SECRET] Test key secret. Used to create orders and to verify the payment
# signature. Backend only, ever.
RAZORPAY_KEY_SECRET=
